{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "AGENTS.md",
    ".github/copilot-instructions.md",
    ".github/instructions/*.instructions.md"
  ],
  "skills": {
    "paths": [".github/skills"]
  },
  "plugin": [
    "opencode-vibeguard",
    "opencode-notify",
    "@tarquinen/opencode-dcp@3.1.14"
  ],
  "formatter": {},
  "lsp": {
    "gopls": {
      "command": ["gopls"]
    }
  },
  "permission": {
    "bash": {
      "*": "allow",
      "git commit*": "ask",
      "git commit --amend*": "deny",
      "git push*": "ask",
      "gh pr create*": "ask",
      "gh pr merge*": "ask"
    }
  }
}
