{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "AGENTS.md",
    ".github/copilot-instructions.md",
    ".github/instructions/*.instructions.md"
  ],
  "plugin": [
    "opencode-vibeguard",
    "opencode-notify",
    "opencode-dynamic-context-pruning"
  ],
  "formatter": {},
  "lsp": {
    "gopls": {
      "command": ["gopls"]
    }
  },
  "permission": {
    "bash": {
      "*": "allow",
      "git commit *": "ask",
      "git push *": "deny",
      "git commit --amend *": "deny"
    }
  }
}
