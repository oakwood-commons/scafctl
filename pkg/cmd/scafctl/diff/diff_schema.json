{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Diff Report",
  "description": "Normalized diff entries shared by the diff subcommands, with display extensions",
  "type": "array",

  "x-kvx-icon": "±",
  "x-kvx-collectionTitle": "Changes",

  "x-kvx-list": {
    "titleField": "path",
    "subtitleField": "group",
    "subtitleMaxLines": 1,
    "badgeFields": ["kind"]
  },

  "x-kvx-detail": {
    "titleField": "path",
    "hiddenFields": [],
    "sections": [
      {
        "title": "",
        "fields": ["kind", "group", "path"],
        "layout": "inline"
      },
      {
        "title": "Before",
        "fields": ["before"],
        "layout": "paragraph"
      },
      {
        "title": "After",
        "fields": ["after"],
        "layout": "paragraph"
      },
      {
        "title": "Detail",
        "fields": ["detail"],
        "layout": "paragraph"
      }
    ]
  },

  "items": {
    "type": "object",
    "required": ["path", "kind"],
    "properties": {
      "kind": {
        "type": "string",
        "title": "Kind",
        "maxLength": 10,
        "x-kvx-priority": 10
      },
      "group": {
        "type": "string",
        "title": "Group",
        "maxLength": 16,
        "x-kvx-priority": 8
      },
      "path": {
        "type": "string",
        "title": "Path",
        "maxLength": 40,
        "x-kvx-priority": 9
      },
      "detail": {
        "type": "string",
        "title": "Detail",
        "maxLength": 30,
        "x-kvx-priority": 6
      },
      "before": {
        "title": "Before"
      },
      "after": {
        "title": "After"
      }
    }
  }
}
